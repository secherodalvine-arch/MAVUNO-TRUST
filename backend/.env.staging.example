# ==============================================================================
# MAVUNOTRUST STAGING ENVIRONMENT CONFIGURATION (.env.staging)
# ==============================================================================
# Use this configuration for the staging backend instance (mavunotrust-backend-staging).
#
# HARD ISOLATION RULE:
# - DB_NAME MUST be 'mavunotrust-staging'.
# - The backend enforces this in src/config/db.js to prevent touching production.
# - The MongoDB Atlas user should be scoped with 'readWrite' ONLY on 'mavunotrust-staging'.
# ==============================================================================

NODE_ENV=staging
PORT=8000

# MongoDB Staging Connection (Separate Database Name: mavunotrust-staging)
# Example Atlas format: mongodb+srv://staging_user:<password>@cluster0.mongodb.net/mavunotrust-staging?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/mavunotrust-staging
DB_NAME=mavunotrust-staging

# Staging Frontend URL & Allowed CORS Origins
FRONTEND_URL=https://mavunotrust-staging.vercel.app
CORS_ORIGIN=https://mavunotrust-staging.vercel.app

# Distinct Staging JWT Secrets (NEVER reuse production secrets)
JWT_SECRET=generate_distinct_random_staging_secret_minimum_32_characters_here
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Market Data / KAMIS Configuration
KAMIS_BASE_URL=https://kamis.kilimo.go.ke
MAVUNOAGENT_MODEL=gemini-2.5-flash

# Staging Gemini API Key
GEMINI_API_KEY=your_staging_gemini_api_key_here

# Google Earth Engine (Sentinel-2 Satellite Monitoring)
GEE_PROJECT_ID=your_staging_gee_project_id
GEE_SERVICE_ACCOUNT_EMAIL=your_staging_service_account@project.iam.gserviceaccount.com
GEE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_key\n-----END PRIVATE KEY-----\n"

# Firebase Cloud Messaging (Push Notifications - Staging)
FIREBASE_PROJECT_ID=your_staging_firebase_project_id
FIREBASE_SERVER_KEY=your_staging_firebase_server_key

# TalkSasa SMS (Kenyan SMS Gateway - Staging)
TALKSASA_API_KEY=your_staging_talksasa_api_key
TALKSASA_SENDER_ID=MavunoStaging
TALKSASA_API_URL=https://api.talksasa.com/v1/send/sms
