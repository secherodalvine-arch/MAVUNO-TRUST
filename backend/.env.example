# Backend Environment Variables
PORT=8000
MONGODB_URI=mongodb://localhost:27017/mavunotrust
DB_NAME=mavunotrust

FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

JWT_SECRET=your_jwt_secret_here
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# MavunoAgent — KAMIS Market Data Extraction Agent
KAMIS_BASE_URL=https://kamis.kilimo.go.ke
MAVUNOAGENT_MODEL=gemini-3.5-flash

# ElevenLabs API — Homepage Agent
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_AGENT_ID=your_elevenlabs_agent_id_here

# ElevenLabs API — Customer Support Voice Agent (Distinct API credentials)
ELEVENLABS_CUSTOMER_SUPPORT_API_KEY=your_customer_support_api_key_here
ELEVENLABS_CUSTOMER_SUPPORT_AGENT_ID=your_customer_support_agent_id_here

# Gemini API (Used by market advisory agents; deterministic transport calculations work without it)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash

# Google Earth Engine (GEE) — Sentinel-2 Satellite Monitoring (Phase 2)
# Register cloud project at https://earthengine.google.com (Non-commercial / Research)
# Service account requires 'Earth Engine Resource Viewer' role
# Option A (Recommended for Render): Render Secret File mounted at /etc/secrets/gee-service-account.json
GEE_CREDENTIALS_PATH=/etc/secrets/gee-service-account.json
# Option B (Local / Direct Environment Variables):
GEE_PROJECT_ID=satellite-monitoring-514409
GEE_SERVICE_ACCOUNT_EMAIL=gee-satellite-monitor@satellite-monitoring-514409.iam.gserviceaccount.com
GEE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_rsa_private_key_here\n-----END PRIVATE KEY-----\n"

# Firebase Cloud Messaging (FCM) — Push Notifications (Phase 5)
# Option A (Recommended for Render): Render Secret File mounted at /etc/secrets/firebase-service-account.json
FIREBASE_CREDENTIALS_PATH=/etc/secrets/firebase-service-account.json
# Option B (Local / Direct Environment Variables):
FIREBASE_PROJECT_ID=satellite-monitoring-514409
FIREBASE_CLIENT_EMAIL=fcm-notifier@satellite-monitoring-514409.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_rsa_private_key_here\n-----END PRIVATE KEY-----\n"
# Option C (Legacy Server Key):
FIREBASE_SERVER_KEY=your_firebase_server_key_here

# TalkSasa — Kenyan SMS Gateway for Agricultural Alerts (Phase 5)
TALKSASA_API_KEY=your_talksasa_api_key_here
TALKSASA_SENDER_ID=MavunoTrust
TALKSASA_API_URL=https://api.talksasa.com/v1/send/sms

# OpenStreetMap & OSRM Transport Routing Configuration
# Public demo server is used by default for testing/evaluation.
# For production SLA, self-host OSRM (e.g. docker run -t -i -p 5000:5000 ghcr.io/project-osrm/osrm-backend)
OSRM_BASE_URL=https://router.project-osrm.org
OSRM_TIMEOUT_MS=8000
OSRM_THROTTLE_MS=200

# OpenStreetMap Nominatim Geocoding Configuration
# Obey Nominatim Usage Policy: max 1 request/second and valid User-Agent.
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=MavunoTrust-Transport/1.0 (contact@mavunotrust.co.ke)
NOMINATIM_THROTTLE_MS=1100

# Optional Transport Quality & Economic Baseline Overrides (KSh)
# MIN_PLAUSIBLE_RATE_PER_KM=5
# MAX_PLAUSIBLE_RATE_PER_KM=1500
# BASE_CHARGE_PICKUP=1200
# BASE_CHARGE_SMALL_TRUCK=3000

